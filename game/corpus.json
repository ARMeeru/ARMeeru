    "file": "percentile.rs",
    "lines": [
      "fn percentile(sorted: &[f64], p: f64) -> f64 {",
      "    let idx = (p / 100.0 * sorted.len() as f64) as usize;",
      "    sorted[idx]",
      "}"
    ]
