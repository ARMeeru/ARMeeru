    "id": "py-batch",
    "lang": "Python",
    "file": "batch.py",
    "lines": [
      "def batched(items, size, batch=[]):",
      "    \"\"\"Split items into lists of at most `size`.\"\"\"",
      "    out = []",
      "    for it in items:",
      "        batch.append(it)",
      "        if len(batch) == size:",
      "            out.append(batch)",
      "            batch = []",
      "    if batch:",
      "        out.append(batch)",
      "    return out"
    ]
  },
