      "\tvar total int64",
      "\tfor _, p := range paths {",
      "\t\tf, err := os.Open(p)",
      "\t\tif err != nil {",
      "\t\t\treturn 0, err",
      "\t\t}",
      "\t\tdefer f.Close()",
      "\t\tn, err := count(f)",
      "\t\tif err != nil {",
      "\t\t\treturn 0, err",
      "\t\t}",
      "\t\ttotal += n",
      "\t}",
      "\treturn total, nil",
      "}"
