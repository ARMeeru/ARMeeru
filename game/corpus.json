    "id": "ts-median",
    "lang": "TypeScript",
    "file": "median.ts",
    "lines": [
      "function median(xs: number[]) {",
      "  const s = [...xs].sort();",
      "  const mid = Math.floor(s.length / 2);",
      "  return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2;",
      "}"
    ]
  },
