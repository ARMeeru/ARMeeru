      "async function saveAll(records: Rec[]) {",
      "  const failures: string[] = [];",
      "  records.forEach(async (r) => {",
      "    try {",
      "      await db.put(r);",
      "    } catch {",
      "      failures.push(r.id);",
      "    }",
      "  });",
      "  return failures;",
      "}"
