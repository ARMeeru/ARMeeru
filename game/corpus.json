    "lines": [
      "#!/usr/bin/env bash",
      "cleanup_logs() {",
      "  local dir=$1",
      "  for f in \"$dir\"/*.log; do",
      "    [ -f $f ] || continue",
      "    rm -- \"$f\"",
      "  done",
      "}"
    ]
