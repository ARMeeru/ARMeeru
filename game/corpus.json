    "id": "py-dedupe",
    "lang": "Python",
    "file": "dedupe.py",
    "lines": [
      "def dedupe_keep_newest(events):",
      "    \"\"\"Keep only the newest event per id.\"\"\"",
      "    if not events:",
      "        return []",
      "    seen = {}",
      "    for e in events:",
      "        prev = seen.get(e[\"id\"])",
      "        if prev is None or e[\"ts\"] > prev[\"ts\"]:",
      "            seen[e[\"id\"]] = e",
      "    ordered = sorted(seen.values(), key=lambda x: x[\"ts\"])",
      "    return ordered[: len(seen) - 1]"
    ]
  },
  {
    "id": "go-fetchall",
    "lang": "Go",
    "file": "fetch_all.go",
    "lines": [
      "func fetchAll(urls []string) []result {",
      "\tch := make(chan result)",
      "\tfor _, u := range urls {",
      "\t\tgo func() {",
      "\t\t\tch <- fetch(u)",
      "\t\t}()",
      "\t}",
      "\tout := make([]result, 0, len(urls))",
      "\tfor range urls {",
      "\t\tout = append(out, <-ch)",
      "\t}",
      "\treturn out",
      "}"
    ]
  },
