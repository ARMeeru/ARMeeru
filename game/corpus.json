    "id": "py-dropstale",
    "lang": "Python",
    "file": "sessions.py",
    "lines": [
      "def drop_stale(sessions, cutoff):",
      "    for sid, last in sessions.items():",
      "        if last < cutoff:",
      "            del sessions[sid]",
      "    return sessions"
    ]
